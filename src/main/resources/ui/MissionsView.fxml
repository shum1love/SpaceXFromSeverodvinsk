<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.SelectionMode?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.spacecompany.ui.MissionsController" styleClass="view">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <Label text="Миссии" styleClass="h1"/>
    <TableView fx:id="table" prefHeight="200" styleClass="table">
        <placeholder>
            <Label text="Миссий пока нет — создайте первую!"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="nameColumn" text="Название" prefWidth="200"/>
            <TableColumn fx:id="typeColumn" text="Тип" prefWidth="180"/>
            <TableColumn fx:id="statusColumn" text="Статус" prefWidth="120"/>
            <TableColumn fx:id="rewardColumn" text="Награда" prefWidth="130"/>
            <TableColumn fx:id="crewColumn" text="Экипаж" prefWidth="90"/>
        </columns>
    </TableView>
    <HBox spacing="16">
        <VBox spacing="6">
            <Label text="Ракета (выбор назначает сразу)" styleClass="h2"/>
            <ComboBox fx:id="rocketCombo" prefWidth="260"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Экипаж (Ctrl+клик — несколько)" styleClass="h2"/>
            <ListView fx:id="crewList" prefHeight="110"/>
            <Button text="Сохранить экипаж" onAction="#saveCrew"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Готовность" styleClass="h2"/>
            <Label fx:id="readinessLabel" text="Выберите миссию в таблице." wrapText="true"/>
            <HBox spacing="8">
                <ProgressIndicator fx:id="launchProgress" prefWidth="32" prefHeight="32" visible="false"/>
            </HBox>
        </VBox>
    </HBox>
    <HBox spacing="8">
        <Button text="Создать" onAction="#create" styleClass="btn-primary"/>
        <Button text="Запустить" onAction="#launch" styleClass="btn-primary"/>
        <Button text="Запустить все готовые" onAction="#launchAll"/>
        <Button text="Отменить" onAction="#cancel"/>
    </HBox>
    <Label text="Бортовой журнал последнего полёта" styleClass="h2"/>
    <TextArea fx:id="flightLog" editable="false" wrapText="true" VBox.vgrow="ALWAYS" styleClass="log"/>
</VBox>
