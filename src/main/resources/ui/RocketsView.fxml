<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.spacecompany.ui.RocketsController" styleClass="view">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <Label text="Ракеты" styleClass="h1"/>
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="table">
        <placeholder>
            <Label text="Ракет пока нет — купите первую!"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="nameColumn" text="Название" prefWidth="180"/>
            <TableColumn fx:id="modelColumn" text="Модель" prefWidth="120"/>
            <TableColumn fx:id="statusColumn" text="Статус" prefWidth="130"/>
            <TableColumn fx:id="fuelColumn" text="Топливо" prefWidth="90"/>
            <TableColumn fx:id="conditionColumn" text="Состояние" prefWidth="100"/>
            <TableColumn fx:id="reliabilityColumn" text="Надёжн." prefWidth="90"/>
            <TableColumn fx:id="flightsColumn" text="Успех/всего" prefWidth="110"/>
        </columns>
    </TableView>
    <HBox spacing="8">
        <Button text="Купить" onAction="#buy" styleClass="btn-primary"/>
        <Button text="Заправить" onAction="#refuel"/>
        <Button text="Ремонт" onAction="#repair"/>
        <Button text="На обслуживание / снять" onAction="#maintenance"/>
    </HBox>
</VBox>
