<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.spacecompany.ui.EmployeesController" styleClass="view">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <Label text="Сотрудники" styleClass="h1"/>
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="table">
        <placeholder>
            <Label text="Сотрудников пока нет — наймите первого!"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="nameColumn" text="Имя" prefWidth="180"/>
            <TableColumn fx:id="roleColumn" text="Роль" prefWidth="130"/>
            <TableColumn fx:id="salaryColumn" text="Зарплата" prefWidth="130"/>
            <TableColumn fx:id="experienceColumn" text="Опыт" prefWidth="80"/>
            <TableColumn fx:id="skillColumn" text="Навык" prefWidth="80"/>
            <TableColumn fx:id="statusColumn" text="Статус" prefWidth="130"/>
        </columns>
    </TableView>
    <HBox spacing="8">
        <Button text="Нанять" onAction="#hire" styleClass="btn-primary"/>
        <Button text="Уволить" onAction="#fire"/>
        <Button text="Обучить" onAction="#train"/>
        <Button text="Отпуск / возврат" onAction="#toggleLeave"/>
        <Button text="Выплатить зарплаты" onAction="#paySalaries"/>
    </HBox>
</VBox>
