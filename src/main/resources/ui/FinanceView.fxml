<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.spacecompany.ui.FinanceController" styleClass="view">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <Label text="Финансы" styleClass="h1"/>
    <Label fx:id="summaryLabel" text="..." styleClass="summary" wrapText="true"/>
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="table">
        <placeholder>
            <Label text="Операций пока нет."/>
        </placeholder>
        <columns>
            <TableColumn fx:id="timeColumn" text="Когда" prefWidth="200"/>
            <TableColumn fx:id="amountColumn" text="Сумма" prefWidth="160"/>
            <TableColumn fx:id="descriptionColumn" text="Описание" prefWidth="420"/>
        </columns>
    </TableView>
    <HBox spacing="8">
        <Button text="Выплатить зарплаты" onAction="#paySalaries"/>
    </HBox>
</VBox>
